{{ 'product-content-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --product-content-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --product-content-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --product-content-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --product-content-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  }
{%- endstyle -%}

<div class="product-content-accordion color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <details class="product-content-accordion__details"{% if section.settings.default_state == 'open' %} open{% endif %}>
      <summary class="product-content-accordion__summary">
        <span class="product-content-accordion__summary-title h4{% unless section.settings.show_title %} visually-hidden{% endunless %}">
          {{ section.settings.title | default: 'Product Content' | escape }}
        </span>
        <span class="product-content-accordion__toggle" aria-hidden="true"></span>
      </summary>

      <div class="product-content-accordion__body">
        <div class="product-content-accordion__blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="product-content-accordion__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
              {%- when 'rich_text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="product-content-accordion__rich-text rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <figure class="product-content-accordion__image product-content-accordion__image--{{ block.settings.alignment }}" style="--product-content-image-width: {{ block.settings.image_width }}%;" {{ block.shopify_attributes }}>
                    {{
                      block.settings.image
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 550, 750, 1100, 1500, 2000',
                        sizes: '(min-width: 990px) 900px, calc(100vw - 40px)',
                        alt: block.settings.alt_text
                    }}
                    {%- if block.settings.caption != blank -%}
                      <figcaption class="caption">{{ block.settings.caption | escape }}</figcaption>
                    {%- endif -%}
                  </figure>
                {%- endif -%}
              {%- when 'custom_liquid' -%}
                {%- if block.settings.custom_liquid != blank -%}
                  <div class="product-content-accordion__custom-liquid" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Product content accordion",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Product Details" },
    { "type": "checkbox", "id": "show_title", "label": "Show section title", "default": true },
    {
      "type": "select",
      "id": "default_state",
      "label": "Default state",
      "options": [
        { "value": "open", "label": "Open" },
        { "value": "closed", "label": "Closed" }
      ],
      "default": "open"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top spacing", "default": 36 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 36 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top spacing", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 24 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Product detail heading" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h3", "label": "Small" },
            { "value": "h2", "label": "Medium" },
            { "value": "h1", "label": "Large" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "rich_text",
      "name": "Rich text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add product information here.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt_text", "label": "Image alt text" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "range", "id": "image_width", "min": 30, "max": 100, "step": 5, "unit": "%", "label": "Image width", "default": 100 },
        {
          "type": "select",
          "id": "alignment",
          "label": "Image alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }
      ]
    }
  ],
  "presets": [
    { "name": "Product content accordion", "blocks": [{ "type": "rich_text" }] }
  ]
}
{% endschema %}
