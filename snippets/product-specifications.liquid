{%- comment -%}
  Render populated product metafields in a single, closed-by-default accordion.
  Each group is captured before its heading is output so empty groups stay hidden.
{%- endcomment -%}
{%- capture specification_groups -%}
  {%- for group_number in (1..3) -%}
    {%- liquid
      assign show_group = false
      case group_number
        when 1
          assign show_group = block.settings.show_battery
          assign group_key = 'battery'
          assign fields = 'model|energy|cell_brand|chemistry|nominal_voltage|nominal_capacity|tested_capacity|cycle_life|continuous_current|max_current|operating_temperature' | split: '|'
        when 2
          assign show_group = block.settings.show_bms_protection
          assign group_key = 'bms_protection'
          assign fields = 'bms_model|bms_current|active_balancing|circuit_breaker|fire_protection|heating_function' | split: '|'
        when 3
          assign show_group = block.settings.show_communication
          assign group_key = 'communication_group'
          assign fields = 'communication|parallel_support' | split: '|'
      endcase
    -%}
    {%- if show_group -%}
      {%- capture group_rows -%}
        {%- for field in fields -%}
          {%- liquid
            assign specification = product.metafields.custom[field]
            assign value = specification.value
          -%}
          {%- if value != blank -%}
            {%- liquid
              case field
                when 'model'
                  assign label = 'Model'
                when 'energy'
                  assign label = 'Energy'
                when 'cell_brand'
                  assign label = 'Cell Brand'
                when 'chemistry'
                  assign label = 'Chemistry'
                when 'nominal_voltage'
                  assign label = 'Nominal Voltage'
                when 'nominal_capacity'
                  assign label = 'Nominal Capacity'
                when 'tested_capacity'
                  assign label = 'Tested Capacity'
                when 'cycle_life'
                  assign label = 'Cycle Life'
                when 'continuous_current'
                  assign label = 'Continuous Current'
                when 'max_current'
                  assign label = 'Max Current'
                when 'operating_temperature'
                  assign label = 'Operating Temperature'
                when 'bms_model'
                  assign label = 'BMS Model'
                when 'bms_current'
                  assign label = 'BMS Current'
                when 'active_balancing'
                  assign label = 'Active Balancing'
                when 'circuit_breaker'
                  assign label = 'Circuit Breaker'
                when 'fire_protection'
                  assign label = 'Fire Protection'
                when 'heating_function'
                  assign label = 'Heating Function'
                when 'communication'
                  assign label = 'Communication'
                when 'parallel_support'
                  assign label = 'Parallel Support'
              endcase
            -%}
            <div class="product-specifications__row">
              <dt class="product-specifications__label">{{ label }}</dt>
              <dd class="product-specifications__value">{{ value | escape }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign group_rows = group_rows | strip -%}
      {%- if group_rows != blank -%}
        {%- assign group_title_key = 'products.specifications.' | append: group_key -%}
        <section class="product-specifications__group">
          <h3 class="product-specifications__group-title h5">{{ group_title_key | t }}</h3>
          <dl class="product-specifications__rows">{{ group_rows }}</dl>
        </section>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign specification_groups = specification_groups | strip -%}
{%- if specification_groups != blank -%}
  <div class="product__accordion accordion product-specifications quick-add-hidden" style="--product-specifications-spacing: {{ block.settings.spacing_top }}px" {{ block.shopify_attributes }}>
    <details id="ProductSpecifications-{{ block.id }}-{{ section.id }}">
      <summary>
        <span class="summary__title">
          <span class="h4 accordion__title">
            {%- if block.settings.heading != blank -%}
              {{- block.settings.heading | escape -}}
            {%- else -%}
              {{- 'products.specifications.title' | t -}}
            {%- endif -%}
          </span>
        </span>
        <span class="product-specifications__toggle" aria-hidden="true"></span>
      </summary>
      <div class="accordion__content product-specifications__content">
        <div class="product-specifications__table">
          <div class="product-specifications__table-header">
            <span>Parameter</span>
            <span>Specification</span>
          </div>
          {{ specification_groups }}
        </div>
      </div>
    </details>
  </div>
{%- endif -%}
